# DirectStay — environment variables
# Copy this file to `.env` for local overrides. `.env` is gitignored.

# Only variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle. They are
# PUBLIC by design (the Supabase anon key is protected by RLS, not by secrecy). Never put
# the Supabase service-role key or any Stripe secret key in an EXPO_PUBLIC_ variable.

# EAS_BUILD_PROFILE (development | preview | production) is injected automatically by
# EAS Build and read by app.config.ts. It does not need to be set for local runs.

# Which environment this build targets. Defaults to `development`.
EXPO_PUBLIC_APP_ENV=development

# --- Remote Supabase (default for everyday development) ---
# Everyday development targets the hosted "directstay" development project directly; there
# is no requirement to run Supabase locally. Get the URL/anon key from the Supabase
# dashboard (Project Settings > API) for the project you're pointed at.
#   development: remote development project (used day to day)
#   preview:     isolated preview project
#   production:  production project
# Values for preview/production live in EAS secrets / the deployment environment, never in git.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ORGANIZATION_SLUG=ayni-hospitality

# --- Local Supabase stack (optional, for schema/RLS/pgTAP work) ---
# Only needed when authoring migrations or running pgTAP locally. Start it with
# `supabase start`, then copy the API URL and anon key printed by `supabase status`
# (or `supabase status -o env`).
# EXPO_PUBLIC_APP_ENV=local
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
